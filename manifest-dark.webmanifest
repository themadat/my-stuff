{
  "name": "My Stuff",
  "short_name": "My Stuff",
  "description": "A local-first inventory of the things you own and used to own.",
  "id": "./my-stuff",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#121616",
  "theme_color": "#121616",
  "orientation": "any",
  "categories": ["utilities"],
  "icons": [
    { "src": "assets/icons/icon-192-dark.png?v=0.0.1.25", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-dark.png?v=0.0.1.25", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-maskable-dark.png?v=0.0.1.25", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
